          },
          {
            "name": "x-fapi-epoch-millis",
            "type": "string",
            "required": true,
            "in": "header",
            "description": "The Epoch millis at the time of hitting the API request. Axis bank will verify the header to ensure that the request isn’t too old."
          },
          {
            "name": "x-fapi-uuid",
            "type": "string",
            "required": true,
            "in": "header",
            "description": "Unique alphanumeric Id (without special characters) should be generated by consumer. It should be unique for each request"
          },
          {
            "name": "x-fapi-serviceId",
            "type": "string",
            "required": true,
            "in": "header",
            "description": "x-fapi-serviceId"
          },
          {
            "name": "x-fapi-serviceVersion",
            "type": "string",
            "required": true,
            "in": "header",
            "description": "x-fapi-serviceVersion"
          },
          {
            "name": "x-axis-test-id",
            "required": true,
            "in": "header",
            "type": "integer",
            "format": "int32",
            "description": "This is the test-id header. It will be used for creating the type of response that is required."
          }
        ],
        "description": "This API will be used by Corporates to maintain VAN master data for offline validation within Axis Bank. Request to\\_create/ modify/ deactivate VAN data will be received through single web service & response will be shared on real-time. On the basis of the X-AXIS-TEST-ID parameter, the API will respond accordingly for different conditions. For eg: 1=Success , 2= Failure, Others = Invalid Test Id."
      }
    }
